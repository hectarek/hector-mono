{
  "$schema": "https://v2-11-5.turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": [
        "$TURBO_EXTENDS$",
        "DATABASE_URL",
        "NEON_AUTH_BASE_URL",
        "NEON_AUTH_COOKIE_SECRET",
        "OWNER_USER_ID",
        "AGENT_USER_ID",
        "GOOGLE_OAUTH_CLIENT_ID",
        "GOOGLE_OAUTH_CLIENT_SECRET",
        "GOOGLE_CALENDAR_ACCOUNT_EMAIL",
        "CALENDAR_TOKEN_KEY",
        "LOG_LEVEL"
      ]
    }
  }
}
