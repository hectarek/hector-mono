# Copy to .env and fill in with the Neon test project's values only. Production values live
# only in Vercel's Production environment (docs/build-plan.md, KTD17). Never commit .env.

# Neon Postgres connection string (pooled).
DATABASE_URL=
# Neon Auth (Neon console → Auth): the auth URL and a random cookie secret (32+ characters).
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
# The Neon Auth user ids of the two accounts that use the app: the owner's and the agent's.
# Until both are set to user ids, every session is refused.
OWNER_USER_ID=
AGENT_USER_ID=
# Google OAuth web client for the calendar, the account it connects, and the token key.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_CALENDAR_ACCOUNT_EMAIL=
CALENDAR_TOKEN_KEY=
# debug | info | warn | error (optional; defaults to debug in development, warn in production, error in tests).
LOG_LEVEL=
