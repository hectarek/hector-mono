# Copy to .env and fill in. Never commit .env.

# Neon Postgres connection string (pooled).
DATABASE_URL=
# Neon Auth (Neon console → Auth): the auth URL and a random cookie secret (32+ characters).
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
# debug | info | warn | error (optional; defaults to info).
LOG_LEVEL=
