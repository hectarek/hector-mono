{
  "buildCommand": "bun run build",
  "devCommand": "bun run dev",
  "installCommand": "bun install",
  "framework": "nextjs",
  "ignoreCommand": "npx --yes turbo@2 query affected --packages hector-portfolio --base \"${VERCEL_GIT_PREVIOUS_SHA:-HEAD~1}\" --exit-code",
  "env": {
    "ENABLE_EXPERIMENTAL_COREPACK": "1",
    "VERCEL_FORCE_NO_BUILD_CACHE": "1"
  }
}
