# Copy to .env and fill in. Never commit .env.

# Neon Postgres connection string (pooled).
DATABASE_URL=
# Neon Auth (Neon console → Auth): the auth URL and a random cookie secret (32+ characters).
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
# Ably key for live grocery-list updates, limited to publish and subscribe on plan:* (optional locally).
ABLY_API_KEY=
# Vercel AI Gateway key, for recipe import locally. Production uses Vercel OIDC instead.
AI_GATEWAY_API_KEY=
# debug | info | warn | error (optional; defaults to info).
LOG_LEVEL=
# Obsidian vault folder, only for scripts/seed-from-obsidian.ts (optional).
OBSIDIAN_RECIPES_DIR=
