# Copy to .env and fill in with the Neon test project's values only (community-game-library-test).
# Production's values live only in Vercel's Production environment (docs/build-plan.md, KTD1).
# Never commit .env.

# Neon Postgres connection string (pooled).
DATABASE_URL=
# Neon Auth (Neon console → Auth): the auth URL and a random cookie secret (32+ characters).
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
# The Neon Auth user id of the one admin account (KTD1). Missing or not a user id: nobody is the
# admin.
ADMIN_USER_ID=
# Neon's API, for deleting a deleted or removed account's sign-in (U22): a project-scoped API key
# (Neon console → Organization settings → API keys, limited to this project), the project's id,
# and the branch whose Neon Auth holds the users. Missing: a deleted account's sign-in stays, and
# the app logs it.
NEON_API_KEY=
NEON_PROJECT_ID=
NEON_BRANCH_ID=
# Neon Object Storage (KTD11): the branch's S3 endpoint and region, and a storage credential's key
# id and secret. The names are Neon's quickstart's with STORAGE_ in front.
STORAGE_AWS_ENDPOINT_URL_S3=
STORAGE_AWS_REGION=
STORAGE_AWS_ACCESS_KEY_ID=
STORAGE_AWS_SECRET_ACCESS_KEY=
# The bearer token Vercel's schedule sends the daily run (KTD8). Production sets it; leave it
# empty here unless you call the run yourself.
CRON_SECRET=
# debug | info | warn | error (optional; defaults to debug in development, warn in production, error in tests).
LOG_LEVEL=
