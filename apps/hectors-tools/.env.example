# Copy to .env and fill in. Never commit .env.

# Vercel AI Gateway key for local development. Production (once deployed) uses Vercel OIDC instead.
AI_GATEWAY_API_KEY=
# The Gateway model id to use (optional).
AI_MODEL=
# debug | info | warn | error (optional; defaults to debug in dev, warn in production, error in tests).
LOG_LEVEL=
