{
  "name": "hector-mono",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "check": "turbo run lint",
    "ts": "turbo run check-types",
    "check-types": "turbo run check-types",
    "dead-code": "fallow dead-code --fail-on-issues",
    "test": "turbo run test",
    "deps:check": "bun outdated --recursive",
    "deps:update": "bun update --latest --recursive",
    "deps:interactive": "bun update --interactive --recursive",
    "clean:install": "rm -rf node_modules apps/*/node_modules packages/*/node_modules .turbo apps/*/.turbo packages/*/.turbo bun.lock && bun install",
    "react-doctor": "bunx -y react-doctor@latest . --verbose",
    "safari:recipes": "bun run dev --filter=hectors-recipes -- --experimental-https"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@shadcn/lint": "^0.2.0",
    "drizzle-kit": "^0.31.11",
    "fallow": "3.31.0",
    "oxlint": "^1.86.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.5",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
