{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bun check *)",
      "Bash(bun ts *)",
      "Bash(bun test *)",
      "Bash(bun run test *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh run view *)"
    ],
    "ask": [
      "Bash(git stash *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git restore *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(gh pr merge *)"
    ],
    "deny": ["Read(.env*)", "Read(!.env.example)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
