{
  "name": "@repo/ui",
  "version": "0.0.0",
  "private": true,
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./lib/*": "./src/lib/*.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./components/*": "./src/components/*.tsx",
    "./styles/globals.css": "./src/styles/globals.css",
    "./styles/themes/*": "./src/styles/themes/*"
  },
  "scripts": {
    "ts": "tsc --noEmit --strict",
    "check-types": "tsc --noEmit --strict",
    "lint": "bunx biome check --write",
    "lint:quiet": "bunx biome check --write --diagnostic-level=error",
    "ui:add": "bunx --bun shadcn@latest add",
    "test": "bun test"
  },
  "devDependencies": {
    "@repo/biome-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/bun": "1.4.2",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.49.0",
    "next-themes": "^0.4.6",
    "react-day-picker": "^10.0.2",
    "react-resizable-panels": "^4.14.1",
    "recharts": "3.10.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
